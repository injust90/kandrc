    int c, i, nwhite, nother;
    int j = 0;
    int word_count = 0;
    int dword[10];

    nwhite = nother = 0;
    // set starting numbers to 0
    for (i = 0; i < 10; ++i)
        dword[i] = 0;

    // Until end of file, count characters
    while ((c = getchar()) != EOF) {
	if (c >= 'a' && c <= 'z') {
		++word_count;
	}
        else if  (c == ' ' || c == '\n' || c == '\t') {
		if (word_count != 0) {
			++dword[word_count];
		}
